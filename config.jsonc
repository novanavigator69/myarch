{
  "layer": "top",
  "position": "top",
  "exclusive": true,
  "modules-left": [
    "group/power-menu",
    "custom/separator",
    "cpu",
    "memory",
    "temperature"
  ],
  "modules-center": [
    "sway/window"
  ],
  "modules-right": [
    "tray",
    "idle_inhibitor",
    "bluetooth",
    "backlight",
    "network",
    "pulseaudio",
    "custom/separator",
    "clock"
  ],
  
  /* === Modules Left === */
  "custom/archicon": {
    "format": "",
    "on-click": "rofi -show drun",
    "tooltip": false
  },
  "clock": {
    "timezone": "Asia/Kolkata",
    "format": "{:%I:%M %p}",
    "tooltip-format": "{:%A, %B %d, %Y}",
    "on-click": "xdg-open https://calendar.google.com",
    "calendar": {
      "mode": "month"
    }
  },
  "cpu": {
    "format": "{usage}% ",
    "tooltip": true,
    "tooltip-format": "Used CPU: {usage}"
  },
  "memory": {
    "format": "{}% 󰍛",
    "tooltip": true,
    "tooltip-format": "RAM in use: {used} / {total} ({percentage}%)"
  },
  "disk": {
    "format": "{percentage_free}% ",
    "tooltip": true,
    "tooltip-format": "Used space: {used} / {total} ({percentage_free}%)"
  },
  "temperature": {
    "format": "{temperatureC}°C {icon}",
    "tooltip": true, //  "thermal-zone": 2, // Remove or comment out this line
    "hwmon-path": "/sys/class/hwmon/hwmon3/temp3_input",
    "tooltip-format": "Temperature: {temperatureC}°C\nCrítical > 80°C",
    "format-icons": [
      ""
    ]
  },
  /* === Modules Center === */
  "sway/workspaces": {
    "format": "{name}",
    "current-only": true,
    "disable-scroll": false
  },
  /* === Modules Right === */
  "wlr/taskbar": {
    "format": "{icon}",
    "all-outputs": true,
    "active-first": true,
    "tooltip-format": "{name}",
    "on-click": "activate",
    "on-click-middle": "close",
    "ignore-list": [
      "rofi"
    ]
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "",
      "deactivated": ""
    }
  },
  "pulseaudio/slider": {
    "format": "{volume}%",
    "format-muted": " MUTE",
    "step": 5,
    "tooltip": false
  },
  "pulseaudio": {
    "format": "{icon}",
    "format-muted": "muted",
    "format-icons": {
      "default": ["","","",""]
    },
    "tooltip": true,
    "tooltip-format": "{volume}%"
  },
  "network": {
    "format": " ",
    "format-ethernet": "{ifname} 󰈀",
    "format-disconnected": " ",
    "tooltip-format": "{ifname} {ipaddr}/{cidr}",
    "tooltip-format-ethernet": " {ifname} {ipaddr}/{cidr}",
    "tooltip-format-disconnected": "Disconnected",
    "max-length": 50,
    "on-click": "gnome-terminal -e iwctl"
  },
  "backlight": {
      "format": "{icon}",
      "tooltip": false,
      "format-icons": [
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        ""
      ]
    },
  "bluetooth": {
    "format-on": "",
    "format-off": "",
    "format-disabled": "",
    "format-connected": "",
    "format-connected-battery": " {device_battery_percentage}%",
    "tooltip-format": "{device_alias}",
    "tooltip-format-connected": "{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "tooltip-format-enumerate-connected-battery": "{device_alias} — {device_battery_percentage}%",
    "on-click": "blueman-manager"
  },
  "custom/separator": {
    "format": "​",
    "interval": "once",
    "tooltip": false
  },
  "sway/window": {
    "format": {},
    "max-length": 70
  },
  "tray": {
    "icon-size": 14,
    "spacing": 10
  },
  "group/power-menu": {
      "orientation": "horizontal",
      "drawer": {
          "transition-duration": 300,
          "children-class": "not-power",
          "transition-left-to-right": true
      },
      "modules": [
          "custom/poweroff",
          "custom/reboot",
          "custom/suspend",
          "custom/lock"
      ]
  },
  "custom/poweroff": {
      "format": "󰐥",
      "tooltip-text": "Power Off",
      "on-click": "systemctl poweroff"
  },
  "custom/reboot": {
      "format": "󰜉",
      "tooltip-text": "Reboot",
      "on-click": "systemctl reboot"
  },
  "custom/suspend": {
      "format": "󰤄",
      "tooltip-text": "Suspend",
      "on-click": "systemctl suspend"
  },
  "custom/lock": {
      "format": "󰌾",
      "tooltip-text": "Lock Screen",
      "on-click": "swaylock"
  }

}
